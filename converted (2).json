[
  "<!DOCTYPE html>",
  "<html>",
  "<head>",
  "<meta charset=\"utf-8\">",
  "<title>Update Lead</title>",
  "<!-- Include Zoho CRM JS SDK -->",
  "<script src=\"https://live.zohocrm.com/crm/v2/sdk/js/ZohoEmbededAppSDK.min.js\"></script>",
  "</head>",
  "<body>",
  "<h3>Update Lead Details</h3>",
  "<label for=\"leadStatus\">Lead Status</label><br>",
  "<select id=\"leadStatus\">",
  "<option value=\"Not Contacted\">Not Contacted</option>",
  "<option value=\"Attempted to Contact\">Attempted to Contact</option>",
  "<option value=\"Contacted\">Contacted</option>",
  "<option value=\"Pre-Qualified\">Pre-Qualified</option>",
  "</select>",
  "<br><br>",
  "<label for=\"description\">Description / Notes</label><br>",
  "<textarea id=\"description\" rows=\"4\" cols=\"30\"></textarea>",
  "<br><br>",
  "<button id=\"submitBtn\" style=\"padding: 10px 20px; background-color: #007bff; color: white; border: none; cursor: pointer;\">Submit & Update</button>",
  "<script>",
  "let recordId = null;",
  "// Initialize Zoho SDK and capture Entity ID safely",
  "ZOHO.embeddedApp.on(\"PageLoad\", function(data) {",
  "console.log(\"PageLoad Data received:\", data);",
  "if (data) {",
  "if (data.EntityId) {",
  "// Handle if EntityId is an array or string",
  "recordId = Array.isArray(data.EntityId) ? data.EntityId[0] : data.EntityId;",
  "} else if (data.Entity && data.Entity[0]) {",
  "recordId = data.Entity[0];",
  "}",
  "console.log(\"Extracted Record ID:\", recordId);",
  "}",
  "});",
  "ZOHO.embeddedApp.init();",
  "// Handle Submit & Update Click",
  "document.getElementById(\"submitBtn\").addEventListener(\"click\", function() {",
  "if (!recordId) {",
  "alert(\"Error: Lead ID could not be detected. Please close and reopen the widget.\");",
  "return;",
  "}",
  "let selectedStatus = document.getElementById(\"leadStatus\").value;",
  "let notes = document.getElementById(\"description\").value;",
  "var updateData = {",
  "Entity: \"Leads\",",
  "APIData: {",
  "\"id\": recordId,",
  "\"Lead_Status\": selectedStatus,",
  "\"Description\": notes",
  "}",
  "};",
  "console.log(\"Sending update request...\", updateData);",
  "// Call Zoho CRM API to update the record",
  "ZOHO.CRM.API.updateRecord(updateData).then(function(response) {",
  "console.log(\"CRM Update Response:\", response);",
  "let resData = response.data || response;",
  "if (resData && (resData.code === \"SUCCESS\" || (resData[0] && resData[0].code === \"SUCCESS\"))) {",
  "alert(\"Lead updated successfully!\");",
  "ZOHO.CRM.UI.Popup.close();",
  "ZOHO.CRM.UI.Record.reload();",
  "} else {",
  "alert(\"Update failed: \" + JSON.stringify(response));",
  "}",
  "}).catch(function(error) {",
  "console.error(\"API Error caught:\", error);",
  "alert(\"API Error: \" + JSON.stringify(error));",
  "});",
  "});",
  "</script>",
  "</body>",
  "</html>"
]